# Generated files that are committed on purpose. `linguist-generated` collapses
# them by default in GitHub's diff view (still expandable) and keeps them out
# of the language stats; it changes nothing about how git treats them.
#
# Not marked, deliberately:
#   src/data/bots.ts                              generated by scripts/loadBotList.ts,
#                                                 but its diff is the review of who
#                                                 we block (see CLAUDE.md).
#   netlify/database/migrations/*/migration.sql   the reviewable half of a
#                                                 drizzle-kit migration; only the
#                                                 snapshot beside it is noise.
# The other codegen (src/data/members/{core,members}.ts,
# src/data/undrawAspectRatios.ts, next-env.d.ts) is gitignored.

netlify/database/migrations/*/snapshot.json linguist-generated
src/data/monthlyChallenges/data/*.json      linguist-generated
src/data/podcast/episodes.json              linguist-generated
pnpm-lock.yaml                              linguist-generated
