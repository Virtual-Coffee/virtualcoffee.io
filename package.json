{
	"name": "virtualcoffeeio",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=24.20.0"
	},
	"packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"format": "npx prettier --write --ignore-unknown --list-different \"**/*\"",
		"lint": "eslint",
		"build-member-files": "tsx scripts/loadMemberFiles.ts",
		"local-dev": "cross-env NODE_ENV=development pnpm netlify dev",
		"build": "next build",
		"start": "next start",
		"prebuild": "pnpm build-member-files",
		"typecheck": "tsc --noEmit",
		"watch": "npm-watch",
		"dev": "pnpm build-member-files && concurrently \"pnpm watch\" \"pnpm local-dev\""
	},
	"watch": {
		"build-member-files": "src/content/members/**/*.ts"
	},
	"dependencies": {
		"@imgix/js-core": "^3.8.0",
		"@mdx-js/loader": "^3.1.1",
		"@next/mdx": "15.5.18",
		"@sindresorhus/slugify": "^3.0.1",
		"@types/mdx": "^2.0.13",
		"airtable": "^0.12.2",
		"bootstrap": "^4.6.2",
		"calendar-link": "^2.11.0",
		"front-matter": "^4.0.2",
		"graphql": "^16.12.0",
		"graphql-request": "^7.4.0",
		"hast-util-to-string": "^3.0.1",
		"hastscript": "^9.0.1",
		"leaflet": "^1.9.4",
		"luxon": "^3.7.2",
		"mdast-util-toc": "^7.1.0",
		"next": "15.5.21",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"react-leaflet": "^5.0.0",
		"react-leaflet-cluster": "^4.1.3",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-highlight": "^7.0.2",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-frontmatter": "^5.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"sanitize-html": "^2.17.0",
		"unified": "^11.0.5"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.3",
		"@eslint/js": "^9.39.2",
		"@faker-js/faker": "^10.1.0",
		"@netlify/plugin-nextjs": "^5.15.3",
		"@types/leaflet": "^1.9.21",
		"@types/leaflet.markercluster": "^1.5.6",
		"@types/luxon": "^3.7.1",
		"@types/node": "^24.10.4",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@types/sanitize-html": "^2.16.0",
		"concurrently": "^10.0.5",
		"cross-env": "^10.1.0",
		"eslint": "^9.39.2",
		"eslint-config-next": "15.5.18",
		"netlify-cli": "^27.4.2",
		"npm-watch": "^0.13.0",
		"prettier": "^3.7.4",
		"sass": "^1.97.0",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3"
	},
	"overrides": {}
}
