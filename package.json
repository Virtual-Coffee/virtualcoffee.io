{
	"name": "virtualcoffeeio",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=24.20.0"
	},
	"packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"format": "prettier --write --ignore-unknown --list-different .",
		"lint": "eslint",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"build-member-files": "tsx scripts/loadMemberFiles.ts",
		"build-undraw-ratios": "tsx scripts/loadUndrawAspectRatios.ts",
		"build-bot-list": "tsx scripts/loadBotList.ts",
		"check-bot-matching": "vitest run --project unit src/data/botMatcher.test.ts",
		"codegen": "pnpm build-member-files && pnpm build-undraw-ratios",
		"local-dev": "cross-env NODE_ENV=development pnpm netlify dev",
		"build": "next build",
		"start": "next start",
		"prebuild": "pnpm codegen",
		"typecheck": "next typegen && tsc --noEmit",
		"watch": "npm-watch",
		"dev": "pnpm codegen && concurrently \"pnpm watch\" \"pnpm local-dev\"",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "netlify database migrations apply",
		"db:sanitize-preview": "tsx scripts/sanitizePreviewDb.ts"
	},
	"watch": {
		"build-member-files": "src/content/members/**/*.ts",
		"build-undraw-ratios": "public/assets/svg/*.svg"
	},
	"dependencies": {
		"@imgix/js-core": "^3.8.0",
		"@mdx-js/loader": "^3.1.1",
		"@netlify/blobs": "^11.0.3",
		"@netlify/database": "^2.0.1",
		"@next/mdx": "16.3.4",
		"@octokit/auth-app": "^8.3.1",
		"@octokit/rest": "^22.0.1",
		"@sindresorhus/slugify": "^3.0.1",
		"@slack/web-api": "^8.1.1",
		"@tanstack/react-table": "^9.2.4",
		"@types/mdx": "^2.0.14",
		"airtable": "^0.12.2",
		"better-auth": "^1.7.3",
		"better-auth-devtools": "^1.0.1",
		"bootstrap": "^5.3.8",
		"calendar-link": "^2.11.5",
		"drizzle-orm": "1.0.0-rc.4",
		"front-matter": "^4.0.2",
		"graphql": "^16.14.2",
		"graphql-request": "^7.4.0",
		"hast-util-to-string": "^3.0.1",
		"hastscript": "^9.0.1",
		"leaflet": "^1.9.4",
		"luxon": "^3.7.2",
		"mdast-util-toc": "^7.1.0",
		"next": "16.3.4",
		"nodemailer": "^10.0.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-leaflet": "^5.0.0",
		"react-leaflet-cluster": "^4.1.3",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-highlight": "^7.0.2",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-frontmatter": "^5.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"sanitize-html": "^2.17.7",
		"unified": "^11.0.5",
		"uuid": "^14.0.2",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@faker-js/faker": "^10.6.0",
		"@netlify/database-dev": "^1.0.1",
		"@netlify/edge-functions": "^4.0.0",
		"@types/leaflet": "^1.9.22",
		"@types/leaflet.markercluster": "^1.5.6",
		"@types/luxon": "^3.7.5",
		"@types/node": "^24.13.3",
		"@types/nodemailer": "^8.0.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@types/sanitize-html": "^2.16.1",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/coverage-v8": "^5.0.0",
		"@vitest/eslint-plugin": "^1.6.27",
		"concurrently": "^10.0.5",
		"cross-env": "^10.1.0",
		"drizzle-kit": "1.0.0-rc.4",
		"eslint": "^10.10.0",
		"eslint-config-next": "16.3.4",
		"netlify-cli": "^27.4.3",
		"npm-watch": "^0.13.0",
		"prettier": "^3.9.6",
		"sass": "^1.104.0",
		"tsx": "^4.23.13",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vitest": "^5.0.0"
	},
	"overrides": {},
	"intent": {
		"skills": [
			"*"
		]
	}
}
