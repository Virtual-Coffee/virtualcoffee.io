{
	"name": "virtualcoffeeio",
	"version": "0.1.0",
	"private": true,
	"license": "MIT",
	"engines": {
		"node": ">=24.21.0"
	},
	"packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"format": "prettier --write --ignore-unknown --list-different .",
		"lint": "eslint",
		"knip": "knip",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"build-member-files": "tsx scripts/loadMemberFiles.ts",
		"build-undraw-ratios": "tsx scripts/loadUndrawAspectRatios.ts",
		"build-bot-list": "tsx scripts/loadBotList.ts",
		"check-bot-matching": "vitest run --project unit src/data/botMatcher.test.ts",
		"codegen": "pnpm build-member-files && pnpm build-undraw-ratios",
		"local-dev": "cross-env NODE_ENV=development pnpm netlify dev",
		"build": "next build",
		"start": "next start",
		"prebuild": "pnpm codegen",
		"typecheck": "next typegen && tsc --noEmit",
		"watch": "npm-watch",
		"dev": "pnpm codegen && concurrently \"pnpm watch\" \"pnpm local-dev\""
	},
	"watch": {
		"build-member-files": "src/content/members/**/*.ts",
		"build-undraw-ratios": "public/assets/svg/*.svg"
	},
	"dependencies": {
		"@imgix/js-core": "^3.8.0",
		"@mdx-js/loader": "^3.1.1",
		"@next/mdx": "16.3.4",
		"@sentry/nextjs": "^10.75.0",
		"@sindresorhus/slugify": "^3.0.1",
		"@types/mdx": "^2.0.14",
		"airtable": "^0.12.2",
		"bootstrap": "^5.3.8",
		"calendar-link": "^2.11.5",
		"front-matter": "^4.0.2",
		"graphql": "^16.14.2",
		"graphql-request": "^7.4.0",
		"hast-util-to-string": "^3.0.1",
		"hastscript": "^9.0.1",
		"leaflet": "^1.9.4",
		"luxon": "^3.7.2",
		"mdast-util-toc": "^7.1.0",
		"next": "16.3.4",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-leaflet": "^5.0.0",
		"react-leaflet-cluster": "^4.1.3",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-highlight": "^7.0.2",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-frontmatter": "^5.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"sanitize-html": "^2.17.7",
		"unified": "^11.0.5"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@faker-js/faker": "^10.6.0",
		"@netlify/edge-functions": "^4.0.0",
		"@types/estree": "^1.0.9",
		"@types/hast": "^3.0.5",
		"@types/leaflet": "^1.9.22",
		"@types/leaflet.markercluster": "^1.5.6",
		"@types/luxon": "^3.7.5",
		"@types/mdast": "^4.0.4",
		"@types/node": "^24.13.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/sanitize-html": "^2.16.1",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/coverage-v8": "^5.0.0",
		"@vitest/eslint-plugin": "^1.6.27",
		"concurrently": "^10.0.5",
		"cross-env": "^10.1.0",
		"eslint": "^10.10.0",
		"eslint-config-next": "16.3.4",
		"knip": "^6.36.0",
		"netlify-cli": "^27.5.2",
		"npm-watch": "^0.13.0",
		"prettier": "^3.9.6",
		"sass": "^1.104.0",
		"tsx": "^4.23.13",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vitest": "^5.0.0"
	},
	"overrides": {}
}
