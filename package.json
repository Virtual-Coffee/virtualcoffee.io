{
	"name": "virtualcoffeeio",
	"version": "0.1.0",
	"private": true,
	"license": "MIT",
	"engines": {
		"node": ">=24.21.0"
	},
	"packageManager": "pnpm@12.8.2+sha512.a5941679663d952c5f0ecc38ba98af98b4dc01b95780354f6894f2f873973cef2f7e2989d7db3ee5393938ae21f62fe06bcdf685d475ddad829a62095d2b8b11",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"format": "prettier --write --ignore-unknown --list-different .",
		"lint": "eslint",
		"knip": "knip",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"build-member-files": "tsx scripts/loadMemberFiles.ts",
		"build-undraw-ratios": "tsx scripts/loadUndrawAspectRatios.ts",
		"build-bot-list": "tsx scripts/loadBotList.ts",
		"check-bot-matching": "vitest run --project unit src/data/botMatcher.test.ts",
		"codegen": "pnpm build-member-files && pnpm build-undraw-ratios",
		"local-dev": "cross-env NODE_ENV=development pnpm netlify dev",
		"local-dev:tunnel": "cross-env NODE_ENV=development NETLIFY_TUNNEL=1 pnpm netlify dev --live",
		"build": "next build",
		"start": "next start",
		"prebuild": "pnpm codegen",
		"typecheck": "next typegen && tsc --noEmit",
		"watch": "npm-watch",
		"dev": "pnpm codegen && concurrently \"pnpm watch\" \"pnpm local-dev\"",
		"dev:tunnel": "pnpm codegen && concurrently \"pnpm watch\" \"pnpm local-dev:tunnel\"",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx scripts/with-local-netlify.ts drizzle-kit migrate",
		"db:migrate:deploy": "drizzle-kit migrate",
		"db:seed": "tsx scripts/with-local-netlify.ts tsx scripts/seedDev.ts",
		"invite-maintenance": "tsx scripts/with-local-netlify.ts tsx scripts/runInviteMaintenance.ts",
		"email:dev": "cross-env EMAIL_ASSET_ORIGIN=http://localhost:3010 email dev --dir src/emails --port 3010"
	},
	"watch": {
		"build-member-files": "src/content/members/**/*.ts",
		"build-undraw-ratios": "public/assets/svg/*.svg"
	},
	"dependencies": {
		"@googleapis/calendar": "^16.0.0",
		"@imgix/js-core": "^3.8.0",
		"@mdx-js/loader": "^3.1.1",
		"@mdxeditor/editor": "4.3.2",
		"@netlify/blobs": "^11.1.3",
		"@netlify/database": "^2.0.1",
		"@next/mdx": "16.3.8",
		"@octokit/auth-app": "^8.3.1",
		"@octokit/rest": "^22.0.1",
		"@sentry/nextjs": "^11.3.0",
		"@sindresorhus/slugify": "^3.0.1",
		"@slack/web-api": "^8.2.0",
		"@tanstack/react-table": "^9.2.4",
		"@types/mdx": "^2.0.14",
		"airtable": "^0.12.2",
		"better-auth": "^1.7.7",
		"better-auth-devtools": "^1.1.0",
		"bootstrap": "^5.3.8",
		"calendar-link": "^2.11.6",
		"drizzle-orm": "1.0.0-rc.5-ab785fc",
		"front-matter": "^4.0.2",
		"hast-util-to-string": "^3.0.1",
		"hastscript": "^9.0.1",
		"leaflet": "^1.9.4",
		"luxon": "^3.7.2",
		"mdast-util-toc": "^7.1.0",
		"next": "16.3.8",
		"nodemailer": "^10.0.13",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-email": "6.11.0",
		"react-leaflet": "^5.0.0",
		"react-leaflet-cluster": "^4.1.3",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-highlight": "^7.0.2",
		"rehype-parse": "^9.0.1",
		"rehype-remark": "^10.0.1",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-frontmatter": "^5.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"remark-stringify": "^11.0.0",
		"rrule": "2.8.1",
		"sanitize-html": "^2.18.0",
		"unified": "^11.0.5",
		"uuid": "^14.0.2",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@faker-js/faker": "^10.6.0",
		"@netlify/database-dev": "^1.0.1",
		"@netlify/edge-functions": "^4.0.2",
		"@netlify/redirect-parser": "^16.1.1",
		"@react-email/ui": "6.11.0",
		"@slack/types": "^3.2.0",
		"@types/estree": "^1.0.9",
		"@types/hast": "^3.0.5",
		"@types/leaflet": "^1.9.22",
		"@types/leaflet.markercluster": "^1.5.6",
		"@types/luxon": "^3.7.6",
		"@types/mdast": "^4.0.4",
		"@types/node": "^24.19.1",
		"@types/nodemailer": "^8.0.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/sanitize-html": "^2.16.2",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/coverage-v8": "^5.0.3",
		"@vitest/eslint-plugin": "^1.6.27",
		"concurrently": "^10.0.5",
		"cross-env": "^10.1.0",
		"drizzle-kit": "1.0.0-rc.5-ab785fc",
		"eslint": "^10.11.0",
		"eslint-config-next": "16.3.8",
		"knip": "^6.39.0",
		"netlify-cli": "^27.10.2",
		"npm-watch": "^0.13.0",
		"prettier": "^3.9.9",
		"sass": "^1.105.1",
		"tsx": "^4.23.15",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vitest": "^5.0.3"
	},
	"overrides": {},
	"intent": {
		"skills": [
			"@tanstack/*",
			"drizzle-kit",
			"dotenv"
		]
	}
}
